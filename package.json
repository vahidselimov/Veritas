{
  "name": "veritas-corpus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n \"NEXT,API\" -c \"cyan,magenta\" \"next dev\" \"dotnet run --project backend/src/Veritas.Core.Api/Veritas.Core.Api.csproj --urls http://localhost:5000\"",
    "dev:api": "dotnet run --project backend/src/Veritas.Core.Api/Veritas.Core.Api.csproj --urls http://localhost:5000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.1.2",
    "ai": "^3.4.33",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.460.0",
    "next": "^14.2.20",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "docx": "^9.16.0",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
